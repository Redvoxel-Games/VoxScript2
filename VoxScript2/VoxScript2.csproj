<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(ProjectDir)../VoxScript2.props" />

	<PropertyGroup>
		<RootNamespace>VoxScript</RootNamespace>

		<Version>2.0.2</Version>
		<Authors>Redvoxel Games</Authors>
		<RepositoryUrl>https://github.com/Redvoxel-Games/VoxScript2</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Title>VoxScript2</Title>
		<Description>Easily embeddable scripting language</Description>
		<PackageTags>Language, Scripting</PackageTags>
		<PackageReleaseNotes>Added classes and moved execution to VxsThread for future multithreading support</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="./VoxScript.g4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="./README.md" Pack="true" PackagePath="\"/>
		<None Include="../LICENSE.txt" Pack="true" PackagePath="\"/>
	</ItemGroup>
</Project>
