{
  "scopeName": "source.VoxScript2",
  "patterns": [
    {
      "match": "\\b(var|func|for|foreach|while|in|continue|break|if|else|return|print)\\b",
      "name": "keyword.control.VoxScript2"
    },
    {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.VoxScript2"
    },
    {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.VoxScript2"
    },
    {
      "match": "\"([^\"\\\\]|\\\\.)*\"",
      "name": "string.quoted.double.VoxScript2"
    },
    {
      "match": "//.*$",
      "name": "comment.line.VoxScript2"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.VoxScript2"
    }
  ]
}